<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration>
  <!--
    SignPath artifact configuration for the Klipa Player Windows release.
    The upload-artifact step in .github/workflows/windows-release.yml
    submits a ZIP containing:
      KlipaPlayer-Setup-x64.exe      (Inno Setup installer, Authenticode PE)
      KlipaPlayer-Portable-x64.zip   (portable archive, no inner signature)
    SignPath signs the PE inside the ZIP and the installer, then returns
    the rewritten archive.

    File metadata restrictions (required by SignPath Foundation Code of
    Conduct for OSS projects) enforce a consistent product name and a
    single per-build product version on every signed file.
  -->
  <zip-file>
    <include>zip-file</include>
    <include>executable-file</include>

    <file-set>
      <include>KlipaPlayer-Setup-x64.exe</include>
      <exclude-signing-certificates>
        <!-- Do not re-sign artifacts that upstream already signed -->
      </exclude-signing-certificates>
      <metadata>
        <product-name>Klipa Player</product-name>
        <product-version>${product-version}</product-version>
      </metadata>
      <authenticode-signing>
        <!-- SignPath Foundation certificate is applied here -->
      </authenticode-signing>
    </file-set>

    <file-set>
      <include>KlipaPlayer-Portable-x64.zip</include>
      <metadata>
        <product-name>Klipa Player</product-name>
        <product-version>${product-version}</product-version>
      </metadata>
      <!-- Portable archive is left unsigned; only its installer sibling and
           the inner klipa_player.exe carry the signature. SignPath still
           applies metadata restrictions. -->
    </file-set>
  </zip-file>
</artifact-configuration>